# --- App ---
APP_ENV=development
APP_NAME=videaflow-api
DEBUG=false

# --- Postgres (SQLAlchemy async URL) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/videaflow

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Auth (Clerk) ---
# Web (Next.js) — needed to enable real auth. Leave blank for dev mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# API — used to verify session JWTs + sync users/orgs via webhooks.
# Leave blank in local dev to use the DEV identity (dev-only, logs a warning).
CLERK_SECRET_KEY=
CLERK_JWKS_URL=https://YOUR_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://YOUR_INSTANCE.clerk.accounts.dev
CLERK_AUDIENCE=https://YOUR_INSTANCE.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=

# --- Storage (Cloudflare R2 — S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=videaflow-media
R2_PUBLIC_BASE_URL=https://media.videaflow.example
R2_ENDPOINT_URL=

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email ---
RESEND_API_KEY=

# --- AI — LLM (via LiteLLM; only set the keys you use) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=

# --- AI — media providers ---
FAL_KEY=
REPLICATE_API_TOKEN=
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# --- Observability ---
SENTRY_DSN=
